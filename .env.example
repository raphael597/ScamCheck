# ── ScamCheck configuration ──────────────────────────────────────
# Copy to .env and adjust. All AI settings can alternatively be entered
# in the admin area (/admin) – values set here take precedence and are
# shown as locked there.

# Password for the admin area. If empty, a random password is generated on
# first start and written to /data/admin-password.txt (see container logs).
ADMIN_PASSWORD=

# Secret used to encrypt the API key stored via the admin area.
# Recommended: generate once with `openssl rand -base64 32` and keep it.
SETTINGS_SECRET=

# ── AI provider (optional) ──────────────────────────────────────
# none | openai | anthropic | openai_compatible
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_API_KEY=            # generic key, e.g. for OpenRouter/Mistral/Groq
# LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=           # e.g. http://host.docker.internal:11434/v1 for Ollama
# LLM_TEMPERATURE=0.2     # "none" = provider default
# LLM_MAX_TOKENS=2500
# LLM_VISION=true         # send screenshots to the model
# LLM_EFFORT=low          # low | medium | high (Claude & OpenAI reasoning models)

# ── Limits & networking ─────────────────────────────────────────
# CHECK_RATE_LIMIT_PER_HOUR=30
# Behind a reverse proxy (nginx, Traefik, Caddy) set the number of proxy hops
# or "true" so rate limits see the real client IP:
# TRUST_PROXY=1
# MAX_IMAGES=3
# MAX_IMAGE_MB=6
# MAX_TEXT_CHARS=12000
# NEWS_DISABLED=1         # disable the news aggregator
# PORT=8080
